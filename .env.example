# MemoryVerse AI Environment Configuration

# Database Settings
# Set DATABASE_URL to a PostgreSQL connection string for production, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/memoryverse
# Otherwise it defaults to sqlite:///./database/memoryverse.db
DATABASE_URL=sqlite:///./database/memoryverse.db

# JWT Authentication Settings
JWT_SECRET=supersecretjwtkeychangeinproduction1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (OpenAI or Ollama)
# If OPENAI_API_KEY is provided, it uses OpenAI models, otherwise falls back to Ollama or Local Heuristics
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_HOST=http://localhost:11434

# Upload Directory
UPLOAD_DIR=./uploads

# General Settings
ENVIRONMENT=development
PORT=8000
